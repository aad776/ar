# Copy to .env.local and fill in. Both values are PUBLIC (safe in the browser):
# security comes from the Row Level Security policies in supabase/schema.sql.
# Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your deployed URL (used for absolute share-preview image links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
